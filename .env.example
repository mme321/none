# העתיקו ל-.env לפיתוח מקומי (אל תכניסו ל-git!)
DATABASE_URL=postgres://postgres:pg@127.0.0.1:5432/maaser
ENCRYPTION_KEY=            # openssl rand -base64 32
PUBLIC_URL=http://localhost:3000

# התחברות (docs/GOOGLE_SETUP.md). לפיתוח בלבד אפשר DEV_LOGIN=1 במקום
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEV_LOGIN=1

# בנקים בארה"ב – Plaid (docs/BANKS.md)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=

# בנקים בישראל – Salt Edge (docs/BANKS.md)
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
SALTEDGE_SANDBOX=1
SALTEDGE_PRIVATE_KEY=
SALTEDGE_CALLBACK_PUBLIC_KEY=
